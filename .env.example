# ==========================================
# LOCAL DEVELOPMENT CONFIGURATION
# ==========================================
# For local development, the Vite dev server will proxy /api/* requests to your local backend
# Make sure your backend is running on http://localhost:8080

VITE_API_BASE_URL=/api
VITE_APP_ENV=development

# ==========================================
# AUTHENTICATION SETUP
# ==========================================
# For development/testing only - allows auto-login without entering credentials
# DO NOT enable this in production
VITE_ENABLE_DEV_AUTO_LOGIN=true
VITE_ADMIN_LOGIN_TOKEN=your-test-jwt-token-here

# ==========================================
# BACKEND CONFIGURATION
# ==========================================
# Set to true if your backend uses cookie-based sessions instead of JWT
VITE_API_USE_COOKIES=false

# ==========================================
# PRODUCTION CONFIGURATION
# ==========================================
# For production, update .env.production instead
# Set VITE_API_BASE_URL to your live backend URL
# Example: VITE_API_BASE_URL=https://shrishahuprabodhini.in/api