# Used automatically when you run `npm run dev`
# Vite will proxy /api calls to your local Tomcat backend on port 8080.
VITE_API_BASE_URL=/api
VITE_APP_ENV=development
# Development-only: provide a static admin JWT for quick testing (DO NOT commit real tokens)
# Example:
# VITE_ADMIN_LOGIN_TOKEN=eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbkBnbWFpbC5jb20iLCJpYXQiOjE3ODY0NDY5NjQsImV4cCI6MTc4NjUzMzM2NH0.5LdK5u6Zt57CxAsof5bB0RwYV1mBzCfxCPYcMWqSSVc
